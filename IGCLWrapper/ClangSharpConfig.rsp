#------------------ input files

# Input file
--file
../drivers.gpu.control-library/include/igcl_api.h

--traverse
../drivers.gpu.control-library/include/igcl_api.h

# Output namespace  
--namespace
IGCLWrapper

# Output directory
--output
cs_generated

--output-mode
CSharp

# DLL name
--library-path
ControlLib

# Method class name
--method-class-name
IGCL

--language
c++

# --- CREATE TESTS IN ADLXWrapper.Tests PROJECT ---

--test-output
../IGCLWrapper.NativeTests/generated_tests


--generate
helper-types

--generate
doc-includes

--generate
macro-bindings

--generate
tests-xunit

--log
visited-files

# Enable helper types (includes NativeTypeNameAttribute)
--config
file=multi
codegen=latest
types=windows


# Exclude function-like macros that cannot be generated
--exclude
CTL_MAKE_VERSION
--exclude
CTL_MAJOR_VERSION
--exclude
CTL_MINOR_VERSION
--exclude
CTL_BIT
